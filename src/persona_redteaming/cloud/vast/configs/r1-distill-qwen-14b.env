#!/usr/bin/env bash
# r1-distill-qwen-14b.env — deepseek-ai/DeepSeek-R1-Distill-Qwen-14B on one
# A100/H100/H200 box, the preset the first campaign's R1 leg ran (92
# rollouts + 48-layer harvest). NO SECRETS IN THIS FILE, EVER. The only
# secret is HF_TOKEN, named here and delivered by 02_provision.sh over ssh
# stdin to a 0600 file.
#
# Use: QC_CONFIG=r1-distill-qwen-14b bash 01_launch.sh. Copy the file and
# change WORKSTREAM (and the caps) for a new campaign. This serves the BASE
# model; there is no adapter anywhere in the harness.

# ---- workstream identity (CLOUD.md law 8: one box, one owner) ------------
WORKSTREAM="ds-r1-14b-envf"
# shellcheck disable=SC2034  # consumed by lib.sh / 01_launch.sh after sourcing
INSTANCE_LABEL="$WORKSTREAM"
# Hard refusals, on id and on label. The ids are every box MEASURED running on
# another workstream's account on 2026-09-04: 49864289 is the live
# qwen3-32b-coding box, 49841102 is workstream 1's, and the eight after it are
# the axis-run 14B fleet (labels axis-run-14b-w1 .. w8). FOREIGN_LABELS entries
# match as a PREFIX, so "axis-run" also refuses every axis-run-14b-w* box.
# lib.sh DIES if either list is unset or empty: there is no built-in fallback,
# because a stale short list stops refusing the boxes it does not name.
# Beyond these lists, every script refuses any box whose live label is not
# exactly $INSTANCE_LABEL.
FOREIGN_INSTANCES="${FOREIGN_INSTANCES:-49864289 49841102 49859016 49859017 49859018 49859019 49859020 49859129 49859350 49860142}"
FOREIGN_LABELS="${FOREIGN_LABELS:-axis-run env-campaign qwen3-32b-coding qwen32b-envf}"

# ---- prebuilt image (CLOUD.md law 2) -------------------------------------
# VERIFIED 2026-09-04 on the Docker Hub v2 API: tag v0.27.1 exists,
# last_updated 2026-08-11, amd64 9.11GB.
IMAGE="${IMAGE:-vllm/vllm-openai:v0.27.1}"
IMAGE_CUDA_MIN="${IMAGE_CUDA_MIN:-12.9}"   # offers must have cuda_max_good >= this

# ---- offer selection -----------------------------------------------------
# Ranked tiers, tried in order: "<gpu_name>:<min_gpu_ram_GB>:<price_floor>:<price_cap>".
# The min_gpu_ram field is NOT decoration: `gpu_name=A100_SXM4` matches 40GB
# cards too (MEASURED 2026-09-04: 5 of 9 single-GPU A100_SXM4 offers were
# 40960MB). A 29.5GB model fits on a 40GB card, but the harvest does not: it
# holds the weights plus every captured layer of a long suffix, and 80GB is
# what keeps that off --layer-chunks. So the bar stays at 79GB.
#
# TIER ORDER IS ABOUT PRICE HERE, unlike the 32B campaign. 29.5GB of bf16
# weights leave ~50GB of an 80GB card for KV at vLLM's 0.90 default, which is
# far more than 32k of context needs, so the A100 has no capacity problem to
# solve and it is the cheapest of the three. H100 and H200 follow as fallbacks
# for when 80GB A100 supply is empty, which it was at 12:07 UTC on 2026-09-04.
GPU_TIERS="${GPU_TIERS:-A100_SXM4:79:0.60:2.60 H100_SXM:79:1.20:5.50 H200:140:1.20:5.50}"
NUM_GPUS="${NUM_GPUS:-1}"

# CLOUD.md: DISK_GB >= 6 * model_size_GB + 250. DeepSeek-R1-Distill-Qwen-14B is
# 29.54GB bf16 (MEASURED); 6*29.54 + 250 = 427 -> 450. If no offer at 450GB
# passes, 01_launch.sh REPORTS that and stops. It never lowers the disk silently.
DISK_GB="${DISK_GB:-450}"

MIN_RELIABILITY="${MIN_RELIABILITY:-0.995}"
MIN_INET_DOWN="${MIN_INET_DOWN:-500}"    # Mbps; 29.5GB of weights come DOWN
MIN_INET_UP="${MIN_INET_UP:-100}"        # Mbps; the capture pull uses the box's UP
MAX_INET_COST="${MAX_INET_COST:-0.02}"   # $/GB, both directions; reject above
# DSL/JSON UNIT TRAP (MEASURED 2026-09-04): in the search DSL cpu_ram is GB, in
# the raw offer JSON it is MB. `cpu_ram>32000` in the DSL returns ZERO offers.
# The query uses GB; the client-side re-check uses MB.
MIN_CPU_RAM_GB="${MIN_CPU_RAM_GB:-32}"
MIN_CPU_RAM_MB="${MIN_CPU_RAM_MB:-32000}"
MIN_DIRECT_PORTS="${MIN_DIRECT_PORTS:-1}"
GEO_FILTER="${GEO_FILTER:-}"             # extra DSL clauses, e.g. 'geolocation=US'

# ---- model ---------------------------------------------------------------
# Base weights only. MODEL_REVISION pins the commit that is downloaded AND the
# commit that vLLM serves; an empty value tracks the branch head and passes no
# --revision flag anywhere. VERIFIED 2026-09-04 against the HF API: this sha
# resolves on deepseek-ai/DeepSeek-R1-Distill-Qwen-14B (14.77B params).
MODEL_ID="${MODEL_ID:-deepseek-ai/DeepSeek-R1-Distill-Qwen-14B}"   # 29.54GB bf16
MODEL_REVISION="${MODEL_REVISION:-1df8507178afcc1bef68cd8c393f61a886323761}"

# ---- vLLM server ---------------------------------------------------------
SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-r1-distill-qwen-14b}"
MAX_MODEL_LEN="${MAX_MODEL_LEN:-32768}"
VLLM_PORT="${VLLM_PORT:-8000}"
VLLM_HOST="${VLLM_HOST:-127.0.0.1}"
# First knob to reach for if the server OOMs on load: '--gpu-memory-utilization 0.94'.
VLLM_EXTRA_ARGS="${VLLM_EXTRA_ARGS:-}"
VLLM_LOG="${VLLM_LOG:-/workspace/vllm.log}"
# A 14B load (weights read from disk + CUDA graph capture) takes minutes.
VLLM_HEALTH_DEADLINE_SEC="${VLLM_HEALTH_DEADLINE_SEC:-1800}"
VLLM_HEALTH_POLL_SEC="${VLLM_HEALTH_POLL_SEC:-15}"

# ---- python extras on the box (CLOUD.md law 2) ---------------------------
# The image already carries torch + transformers + vLLM. 02 records their
# versions BEFORE and AFTER these installs and FAILS if torch or vllm moved.
# pytest is required: the sanitized-PATH toolchain probe in 02 runs
# `python -m pytest --version` and aborts provisioning if it fails.
EXTRA_PIP="${EXTRA_PIP:-pytest safetensors accelerate}"
# KNOWN RISK, measured 2026-09-04 before launch: aie/pyproject.toml requires
# transformers>=5.16.1 and torch>=2.4, while vLLM v0.27.1 only requires
# transformers>=5.5.3 (read from the v0.27.1 tag's requirements/common.txt).
# If the image ships transformers below 5.16.1, `pip install -e aie` upgrades
# it. That bump is reported and recorded; a torch or vllm move aborts. The two
# ways forward, both deliberate:
#   AIE_PIP_ARGS='--no-deps'   install the package without letting it resolve,
#                              then add whatever it actually needs to EXTRA_PIP
#   choose a newer vLLM image whose transformers already satisfies aie
AIE_PIP_ARGS="${AIE_PIP_ARGS:-}"

# ---- cost guard ----------------------------------------------------------
MAX_HOURS="${MAX_HOURS:-6}"
MAX_DOLLARS="${MAX_DOLLARS:-26.00}"
WATCHDOG_GRACE_MIN="${WATCHDOG_GRACE_MIN:-45}"
HEARTBEAT_FRESH_MIN="${HEARTBEAT_FRESH_MIN:-20}"
WATCHDOG_POLL_SEC="${WATCHDOG_POLL_SEC:-300}"

# ---- remote layout -------------------------------------------------------
REMOTE_ROOT="${REMOTE_ROOT:-/workspace}"
REMOTE_PKG="${REMOTE_PKG:-/workspace/persona-redteaming}"
REMOTE_AIE="${REMOTE_AIE:-/workspace/aie}"
REMOTE_HF_HOME="${REMOTE_HF_HOME:-/workspace/hf_cache}"  # excluded from 04 (reproducible)
FINGERPRINT_PATH="${FINGERPRINT_PATH:-/workspace/env_fingerprint.json}"

# Roots for the capture sweep. The box's $HOME is resolved at capture time and
# appended if it is not already covered. NO extension filter is ever applied.
CAPTURE_ROOTS="${CAPTURE_ROOTS:-/root /workspace}"

# ---- local source trees (rsynced to the box by 02) -----------------------
# LOCAL_PKG is the persona-redteaming repo root (the package, not a data
# tree); LOCAL_AIE the agent-interp-envs fork at the pinned submodule sha.
# 02_provision.sh dies with a named path if either is missing.
LOCAL_PKG="${LOCAL_PKG:-$QC_HERE/../../../..}"
LOCAL_AIE="${LOCAL_AIE:-$LOCAL_PKG/submodules/agent-interp-envs}"
