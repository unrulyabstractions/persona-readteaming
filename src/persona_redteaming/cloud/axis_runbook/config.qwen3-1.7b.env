# config.qwen3-1.7b.env — axis extraction run 1: Qwen/Qwen3-1.7B.
# NO SECRETS IN THIS FILE. Sourced by lib.sh via AXIS_CONFIG.
# Grounding: temp/41-axis-repo-study.md §5 (workload + sizing),
# temp/13-vast-lessons.md Part B + this session's re-measured offers,
# CLOUD.md laws 2/3 (prebuilt image, no bottom-fishing).

MODEL_ID="Qwen/Qwen3-1.7B"
MODEL_TAG="qwen3-1.7b"

# ---- offer selection (CLOUD.md law 3: verified, reliability>0.995) -------
# Tiers tried in order; format gpu_name:min_gpu_ram_gb:price_floor:price_cap.
# Coordinator sizing (2026-09-04): 1.7B -> RTX 4090 24GB tier. Floor 0.30
# rejects bottom-fished hosts; measured 4090 band 0.31-0.54 with n=23 above
# the quality bar. Fallback: 48GB pro cards (RTX 6000Ada measured $0.60,
# rel 0.998, 11.9 Gbps, US datacenter).
GPU_TIERS="${GPU_TIERS:-RTX_4090:23:0.30:0.60 RTX_6000Ada:44:0.55:0.90 L40S:44:0.55:0.90}"
NUM_GPUS=1
DISK_GB="${DISK_GB:-250}"            # 6x3.4GB + 250 (CLOUD.md formula) ~= 270 is the
                                     # ceiling rule-of-thumb; actual need: weights 3.4 +
                                     # HF cache dup + responses ~2 + activations 37.1 +
                                     # rollouts 37.1 + upload staging hardlinks ~= 90GB.
                                     # 250 keeps the disk-is-pennies margin.
MIN_RELIABILITY="${MIN_RELIABILITY:-0.995}"
MIN_INET_DOWN="${MIN_INET_DOWN:-1000}"   # Mbps
MIN_INET_UP="${MIN_INET_UP:-500}"        # Mbps; ~40GB goes UP through the bucket gate
MAX_INET_COST="${MAX_INET_COST:-0.02}"   # $/GB
MIN_CPU_RAM_GB="${MIN_CPU_RAM_GB:-32}"
GEO_FILTER="${GEO_FILTER:-}"             # optional 'geolocation in [US,CA]'; Gemini geo
                                         # is gated by the on-box preflight, not by this

# ---- prebuilt image (CLOUD.md law 2; NEVER pip-resolve torch/vllm on box) -
# vllm/vllm-openai:v0.13.0 matches the assistant-axis uv.lock pin EXACTLY
# (vllm 0.13.0; temp/41 §1). Tag existence VERIFIED on Docker Hub
# 2026-09-04 (last_updated 2025-12-19, amd64 8.9GB).
IMAGE="${IMAGE:-vllm/vllm-openai:v0.13.0}"
IMAGE_CUDA_MIN="${IMAGE_CUDA_MIN:-12.8}"  # offer cuda_max_good must be >= this.
                                          # OPEN: assert the image's real CUDA on the
                                          # canary box (02 fingerprints it); vLLM 0.13
                                          # wheels are cu128-era.
VLLM_PIN="0.13.0"                    # asserted on-box, from the image — never installed
TORCH_PIN="2.9.0"                    # asserted on-box, from the image — never installed
# Pure-python pins the image may lack / carry wrong (from the aa uv.lock,
# temp/41: transformers 5.x BREAKS stage 2). Installed with --no-deps +
# import smoke; extend at the canary if the smoke names more modules.
# NOTE no shell metacharacters here (this string is word-split on the box);
# huggingface_hub is NOT pinned into the image python — the upload gate runs
# via `uv run` in its own PEP-723 env (hub 1.7.2 + hf_xet, temp/42).
# Extended from the aa uv.lock after an import sweep (2026-09-04): stages
# import jsonlines/dotenv/tqdm, and assistant_axis/__init__ pulls .pca ->
# sklearn+plotly (with sklearn's transitive scipy/joblib/threadpoolctl,
# needed explicitly because installs are --no-deps); narwhals is plotly's
# runtime dep.
EXTRA_PIP_PINS="transformers==4.57.5 openai==2.15.0 safetensors==0.7.0 jsonlines==4.0.0 python-dotenv==1.2.1 tqdm==4.67.1 scikit-learn==1.7.2 scipy==1.15.3 joblib==1.5.3 threadpoolctl==3.6.0 plotly==6.5.1 narwhals==2.15.0 attrs==25.4.0"
INSTANCE_LABEL="axis-run"            # hub rule: every instance this workstream creates

# ---- pipeline workload (temp/41 §1, §5) ----------------------------------
S2_BATCH="${S2_BATCH:-8}"            # coordinator sizing: 1.7B stage-2 batch 8 on 24GB
JUDGE_RPS="${JUDGE_RPS:-20}"         # measured: 24 calls <1.1s burst clean, no 429s
                                     # (tools/gemini_limits_measured.json); temp/41 smoke
                                     # ~18 rps clean. Raise only after a clean 1-role run.
JUDGE_BATCH="${JUDGE_BATCH:-20}"
JUDGE_MODEL="gemini-flash-lite-latest"   # hub judge convention
STAGE1_EXTRA="${STAGE1_EXTRA:-}"     # e.g. '--question_count 120' to halve everything
SLICE_ARGS="--roles accountant --question_count 2"  # canary slice (temp/41 §6)

# ---- cost guard ----------------------------------------------------------
# Stage estimates (temp/41 §5): S1 4-9h on a 4090, S2 ~40min, S3 4.6h@20rps
# overlapped with S2, S4/S5 minutes, upload+capture ~1h. Est wall 6-12h;
# MAX_HOURS = 12 + 50% margin (CLOUD.md §7).
MAX_HOURS="${MAX_HOURS:-18}"
WATCHDOG_GRACE_MIN="${WATCHDOG_GRACE_MIN:-60}"
HEARTBEAT_FRESH_MIN="${HEARTBEAT_FRESH_MIN:-20}"
MAX_DOLLARS="${MAX_DOLLARS:-11.00}"  # 18h x $0.60 cap; typical $3-6 at 0.35-0.55/hr

# ---- bucket --------------------------------------------------------------
BUCKET="hf://buckets/unrulyabstractions/persona-redteaming"
BUCKET_PREFIX="axis/qwen3-1.7b"      # full dest = $BUCKET/$BUCKET_PREFIX
PUSH_INTERVAL_SEC=300                # bluedot 5-min partial-pusher cadence

# ---- remote layout -------------------------------------------------------
REMOTE_ROOT=/workspace/axisrun       # runbook remote/ scripts + gate
REMOTE_AA=/workspace/assistant-axis  # rsync'd submodule worktree @ persona-redteaming
OUT_DIR=/workspace/out               # all five stages write ONLY here
UPLOAD_DIR=/workspace/upload_stage   # hardlink tree = OUT_DIR minus activations/*.pt
REMOTE_HF_HOME=/workspace/hf_cache   # model cache (excluded from capture: reproducible)

# ---- local layout (relative to runbook/) ---------------------------------
LOCAL_AA="$AXIS_LIB_HERE/../../../../submodules/assistant-axis"  # main checkout, branch persona-redteaming
AA_REQUIRED_COMMIT="8ad523e"         # must be an ancestor of the shipped HEAD
