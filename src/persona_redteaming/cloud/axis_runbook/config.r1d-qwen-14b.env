# config.r1d-qwen-14b.env — axis extraction run 2:
# deepseek-ai/DeepSeek-R1-Distill-Qwen-14B. NO SECRETS IN THIS FILE.
# Grounding: temp/41-axis-repo-study.md §2 (R1 template fix 8ad523e), §5
# (workload + sizing), temp/40 §2.2/§2.4 (A100_SXM4 fastest-first, PCIE
# power-cap incident, 40GB proven insufficient), CLOUD.md laws 2/3,
# this session's re-measured offers (A100_SXM4 $1.03-1.07, rel 0.991-0.999,
# 1.1-2.2TB disk, 7.7-8.0Gbps, Czechia; H100_SXM $2.00 Idaho fallback).

MODEL_ID="deepseek-ai/DeepSeek-R1-Distill-Qwen-14B"
MODEL_TAG="r1d-qwen-14b"

# ---- offer selection (CLOUD.md law 3; bluedot fastest-first order) -------
# A100_SXM4-80GB is the proven tier for 14B axis runs ($1-1.5 band per
# policy). H100_SXM is the fallback (bluedot's order). A100_PCIE is
# deliberately ABSENT: the 295W power-cap incident made a 14B stage-2 run
# 8h instead of ~2.5h. 48GB cards are UNPROVEN for a 14B axis run and
# 40GB is proven-insufficient — not offered here.
GPU_TIERS="${GPU_TIERS:-A100_SXM4:79:0.90:1.60 H100_SXM:79:1.60:2.60}"
NUM_GPUS=1
DISK_GB="${DISK_GB:-500}"            # temp/41 §5: weights 29.6 + HF cache dup + responses
                                     # ~5 + activations 159.1 + rollouts 159.1 + staging
                                     # hardlinks ~= 360GB; 500 per the 6x+250 formula.
MIN_RELIABILITY="${MIN_RELIABILITY:-0.995}"
MIN_INET_DOWN="${MIN_INET_DOWN:-1000}"   # Mbps
MIN_INET_UP="${MIN_INET_UP:-500}"        # Mbps; ~165GB goes UP through the bucket gate
MAX_INET_COST="${MAX_INET_COST:-0.02}"   # $/GB (165GB x $0.004 ~= $0.7 egress)
MIN_CPU_RAM_GB="${MIN_CPU_RAM_GB:-32}"
GEO_FILTER="${GEO_FILTER:-}"             # Gemini geo is gated by the on-box preflight

# ---- prebuilt image (CLOUD.md law 2) -------------------------------------
IMAGE="${IMAGE:-vllm/vllm-openai:v0.13.0}"   # matches aa uv.lock vllm pin (temp/41 §1);
                                             # tag VERIFIED on Docker Hub 2026-09-04
IMAGE_CUDA_MIN="${IMAGE_CUDA_MIN:-12.8}"
VLLM_PIN="0.13.0"
TORCH_PIN="2.9.0"
# No shell metacharacters; hub/hf_xet live in the gate's own uv env (temp/42).
# Extended per the import sweep — see config.qwen3-1.7b.env comment.
EXTRA_PIP_PINS="transformers==4.57.5 openai==2.15.0 safetensors==0.7.0 jsonlines==4.0.0 python-dotenv==1.2.1 tqdm==4.67.1 scikit-learn==1.7.2 scipy==1.15.3 joblib==1.5.3 threadpoolctl==3.6.0 plotly==6.5.1 narwhals==2.15.0 attrs==25.4.0"
INSTANCE_LABEL="axis-run"

# ---- pipeline workload (temp/41 §2, §5) ----------------------------------
S2_BATCH="${S2_BATCH:-4}"            # bluedot hardcoded 4 for 80GB axis runs; R1
                                     # collect-time seqs are answer-only (short) but
                                     # do not raise without redoing the arithmetic
JUDGE_RPS="${JUDGE_RPS:-20}"
JUDGE_BATCH="${JUDGE_BATCH:-20}"
JUDGE_MODEL="gemini-flash-lite-latest"
# R1 policy (43-runbook decision, README §5.3): keep upstream max_tokens=512
# and min_count=50 for run 1. Truncated-mid-think rollouts score 0/unparsed;
# if >10% of roles fail min_count at stage 4, STOP and escalate — do not
# silently lower min_count or re-generate at higher max_tokens (~3x S1 cost).
STAGE1_EXTRA="${STAGE1_EXTRA:-}"     # '--question_count 120' halves S1/S3/storage
SLICE_ARGS="--roles accountant --question_count 2"

# ---- cost guard ----------------------------------------------------------
# Stage estimates (temp/41 §5): S1 12-24h @2-4k tok/s, S2 3-7h, S3 4.6h@20rps
# overlapped with S2, upload ~159GB (~0.5-1.5h at >=500Mbps up), capture pull
# ~1-3h. Est wall 16-30h; MAX_HOURS = 26 + ~50% margin.
MAX_HOURS="${MAX_HOURS:-38}"
WATCHDOG_GRACE_MIN="${WATCHDOG_GRACE_MIN:-90}"
HEARTBEAT_FRESH_MIN="${HEARTBEAT_FRESH_MIN:-20}"
MAX_DOLLARS="${MAX_DOLLARS:-60.00}"  # 38h x $1.60 worst-tier cap; typical $18-33 at
                                     # $1.03-1.07/hr. CREDIT PRECONDITION: measured
                                     # balance 2026-09-04 = $10.11 — TOP UP >= $60
                                     # before this run (README §1.4).

# ---- bucket --------------------------------------------------------------
BUCKET="hf://buckets/unrulyabstractions/persona-redteaming"
BUCKET_PREFIX="axis/r1d-qwen-14b"
PUSH_INTERVAL_SEC=300

# ---- remote layout -------------------------------------------------------
REMOTE_ROOT=/workspace/axisrun
REMOTE_AA=/workspace/assistant-axis
OUT_DIR=/workspace/out
UPLOAD_DIR=/workspace/upload_stage
REMOTE_HF_HOME=/workspace/hf_cache

# ---- local layout --------------------------------------------------------
LOCAL_AA="$AXIS_LIB_HERE/../../../../submodules/assistant-axis"
AA_REQUIRED_COMMIT="8ad523e"
